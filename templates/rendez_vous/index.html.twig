{% extends 'base_back.html.twig' %}

{% block title %}📅 Liste des Rendez-vous{% endblock %}

{% block body %}

<div class="main-panel">
    <div class="content-wrapper pb-0">
        <div class="container mt-4">
            <h2 class="text-center mb-4 text-uppercase fw-bold">📅 Gestion des Rendez-vous</h2>

            <!-- Barre de recherche, filtre et tri -->
            <div class="mb-4 text-center">
                <div class="row justify-content-center">
                    <div class="col-md-3">
                        <input type="text" id="searchInput" class="form-control search-bar" placeholder="🔎 Rechercher par nom...">
                    </div>
                    <div class="col-md-3">
                        <select id="etatFilter" class="form-control filter-select">
                            <option value="">Filtrer par État</option>
                            <option value="IRM">IRM</option>
                            <option value="ORM">ORM</option>
                            <option value="Scanner">Scanner</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select id="dateSort" class="form-control filter-select">
                            <option value="asc">Date Croissante</option>
                            <option value="desc">Date Décroissante</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row" id="rendezVousContainer">
                {% for rendez_vou in rendez_vouses %}
                    <div class="col-md-4 mb-4 rendez-vous-card" data-id="{{ rendez_vou.id }}" data-etat="{{ rendez_vou.etat }}" data-date="{{ rendez_vou.date ? rendez_vou.date|date('Y-m-d') : '' }}">
                        <div class="card h-100 shadow-sm border-0 rounded-3">
                            <div class="card-body text-center">
                                <h5 class="card-title text-primary fw-bold">🆔 Rendez-vous #{{ rendez_vou.id }}</h5>
                                <p class="card-text text-muted">
                                    👤 <strong>Nom:</strong> <span class="patient-name text-dark">{{ rendez_vou.patientNom }}</span><br>
                                    📧 <strong>Email:</strong> {{ rendez_vou.patientEmail }}<br>
                                    📞 <strong>Téléphone:</strong> {{ rendez_vou.patientTelephone }}<br>
                                    📅 <strong>Date:</strong> {{ rendez_vou.date ? rendez_vou.date|date('d/m/Y') : 'N/A' }}<br>
                                    ⏰ <strong>Heure:</strong> {{ rendez_vou.heure ? rendez_vou.heure|date('H:i') : 'N/A' }}<br>
                                    🔹 <strong>État:</strong> <span class="badge bg-success">{{ rendez_vou.etat }}</span>
                                </p>
                            </div>
                            <div class="card-footer text-center">
    {{ include('rendez_vous/_delete_form.html.twig') }}
    <a href="{{ path('app_rendez_vous_accepter', {'id': rendez_vou.id}) }}" class="btn btn-outline-primary btn-sm " >
        ✅ Accepter
    </a>
   
</div>

                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <p class="text-center text-danger fw-bold">Aucun rendez-vous trouvé.</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<!-- Script pour la recherche dynamique et filtrage -->
<script>
    document.getElementById("searchInput").addEventListener("keyup", function () {
        let filter = this.value.toLowerCase();
        let cards = document.querySelectorAll(".rendez-vous-card");

        cards.forEach(card => {
            let name = card.querySelector(".patient-name").textContent.toLowerCase();
            card.style.display = name.includes(filter) ? "block" : "none";
        });
    });

    document.getElementById("etatFilter").addEventListener("change", function () {
        let selectedEtat = this.value.toLowerCase();
        let cards = document.querySelectorAll(".rendez-vous-card");

        cards.forEach(card => {
            let etat = card.getAttribute("data-etat").toLowerCase();
            card.style.display = (selectedEtat === "" || etat.includes(selectedEtat)) ? "block" : "none";
        });
    });

    document.getElementById("dateSort").addEventListener("change", function () {
        let sortOrder = this.value;
        let cards = Array.from(document.querySelectorAll(".rendez-vous-card"));

        cards.sort((a, b) => {
            let dateA = new Date(a.getAttribute("data-date"));
            let dateB = new Date(b.getAttribute("data-date"));

            return sortOrder === "asc" ? dateA - dateB : dateB - dateA;
        });

        let container = document.getElementById("rendezVousContainer");
        container.innerHTML = ""; // Clear current cards
        cards.forEach(card => container.appendChild(card)); // Re-append sorted cards
    });
</script>








<!-- CSS Personnalisé -->
<style>
    /* Conteneur principal */
    .container {
        position: relative;
        z-index: 2;
    }

    /* Champ de recherche */
    .search-bar {
        border-radius: 50px;
        padding: 12px 20px;
        transition: all 0.3s ease-in-out;
        border: 2px solid #007bff;
        max-width: 300px;
    }

    .search-bar:focus {
        box-shadow: 0 0 10px rgba(0, 123, 255, 0.6);
    }

    /* Sélection des filtres */
    .filter-select {
        border-radius: 50px;
        padding: 12px 20px;
        border: 2px solid #007bff;
        max-width: 200px;
    }

    .filter-select:focus {
        box-shadow: 0 0 10px rgba(0, 123, 255, 0.6);
    }

    /* Cartes */
    .card {
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        border-radius: 15px;
        background: white;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.1);
    }

    /* Style du texte */
    h2 {
        color: #333 !important;
    }

    .text-primary {
        color: #007bff !important;
    }

    .badge {
        font-size: 0.9rem;
        padding: 5px 10px;
    }

    /* Alignement des éléments de filtre et recherche */
    .row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .col-md-3 {
        margin: 0 10px;
    }
</style>

{% endblock %}
