{% extends 'base_front.html.twig' %}

{% block title %}Hello {% endblock %}




{% block body  %}

<!-- Hero Start -->

    <div class="container-fluid bg-primary py-5 mb-5 hero-header">
        <div class="container py-5">
            <div class="row justify-content-start">
                <div class="col-lg-8 text-center text-lg-start">
                    <h5 class="d-inline-block text-primary text-uppercase border-bottom border-5" style="border-color: rgba(256, 256, 256, .3) !important;">Welcome To ElyssaCare</h5>
                    <h1 class="display-1 text-white mb-md-4">Your Health,Our Priority
                    </h1>
                    <div class="pt-2">
                        <a href="" class="btn btn-light rounded-pill py-md-3 px-md-5 mx-2">Find Doctor</a>
                        <a href="" class="btn btn-outline-light rounded-pill py-md-3 px-md-5 mx-2">Appointment</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Hero End -->
    
  
   <div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center">
        <div class="row">
    <div class="col-sm">
     <a href="{{ path('app_frontlab') }}">🔙 Retour à la liste</a>
    </div>
    <div class="col-lg">
      <h4> un Rendez-vous</h4>
    </div>
    <div class="col-sm">
      <a href="{{ path('app_rendez_vous_edit', {'id': rendez_vou.id}) }}">edit</a>
    </div>
  </div>
                
                    
                </div>
        <div class="card-body p-4">

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ rendez_vou.id }}</td>
            </tr>
            <tr>
                <th>Patient_nom</th>
                <td>{{ rendez_vou.patientNom }}</td>
            </tr>
            <tr>
                <th>Patient_email</th>
                <td>{{ rendez_vou.patientEmail }}</td>
            </tr>
            <tr>
                <th>Patient_telephone</th>
                <td>{{ rendez_vou.patientTelephone }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ rendez_vou.date ? rendez_vou.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Heure</th>
                <td>{{ rendez_vou.heure ? rendez_vou.heure|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Etat</th>
                <td>{{ rendez_vou.etat }}</td>
            </tr>
        </tbody>
    </table>

   <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#exampleModal">
    Confirmer
</button>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Confirmation</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        Votre rendez-vous a été confirmé avec succès !
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="redirectButton" data-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

<script>
    document.getElementById('redirectButton').addEventListener('click', function() {
        setTimeout(function() {
            window.location.href = "{{ path('app_frontlab') }}";
        }, 2000); // Redirige après 2 secondes
    });
</script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>


    
    {{ include('rendez_vous/_delete_form.html.twig') }}
    </div>
     </div>
      </div>
       </div>
        </div>

    
{% endblock %}
