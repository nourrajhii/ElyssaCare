{% extends 'base_front.html.twig' %}

{% block body %}
    
    <h1>Events</h1>

    <!-- Bouton flottant pour ajouter un événement -->
   

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Description</th>
                <th>Lieu</th>
                <th>Date</th>
               


                <th>Actions</th>
                 <th>SponsorName</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
                <tr>
                    <td>{{ event.id }}</td>
                    <td>{{ event.title }}</td>
                    <td>{{ event.description }}</td>
                    <td>{{ event.lieu }}</td>
                    <td>{{ event.date|date('Y-m-d H:i') }}</td>
                    <td>
                       
                         <a href="{{ path('app_eventes_show', {'id': event.id}) }}" class="btn btn-info">details for Events</a>
                      
                    </td>
                    <td>
                   {{ event.idSponsor}}</td> 
                </tr>
                
            {% endfor %}
            
        </tbody>
    </table>

 
    </style>

    <!-- Ajout de FontAwesome pour les icônes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

{% endblock %}