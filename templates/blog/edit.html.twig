{% extends 'base_back.html.twig' %}

{% block title %}Modifier le Blog{% endblock %}

{% block stylesheets %}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap');

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #e3f2fd;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            width: 900px;
            max-width: 95%;
            min-height: 550px;
            opacity: 0;
            transform: translateY(-20px);
            animation: fadeIn 0.5s ease-in-out forwards;
            flex-wrap: wrap;
        }

        @keyframes fadeIn {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-container {
            width: 50%;
            padding: 20px;
        }

        .form-container h2 {
            color: #1976D2;
            text-align: center;
            font-weight: 600;
            animation: slideIn 0.5s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-30px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .form-group {
            margin-bottom: 15px;
            text-align: left;
        }

        label {
            font-weight: bold;
            color: #333;
        }

        input, textarea {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            border: none;
            border-bottom: 2px solid #ccc;
            background: transparent;
            font-size: 16px;
            outline: none;
            transition: border-bottom-color 0.3s ease;
        }

        input:focus, textarea:focus {
            border-bottom-color: #1976D2;
        }

        textarea {
            height: 80px;
            resize: none;
        }

        /* 📌 STYLE DES BOUTONS */
        .btn-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            margin-top: 20px;
        }

        .btn {
            padding: 12px 25px;
            width: 100%;
            border: 2px solid black;
            border-radius: 8px;
            background-color: white;
            color: black;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s ease, background-color 0.3s ease, color 0.3s ease;
        }

        .delete-btn:hover {
            background-color: #f5f5f5;
        }

        .delete-btn:active {
            transform: scale(0.95);
        }

        .back-btn {
            background-color: #9E9E9E;
            color: white;
            border: none;
        }

        .back-btn:hover {
            background-color: #757575;
        }

        .image-container {
            width: 45%;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: fadeIn 1s ease-in-out;
        }

        .image-container img {
            width: 100%;
            border-radius: 15px;
            transition: transform 0.3s ease-in-out;
        }

        .image-container img:hover {
            transform: scale(1.1);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        /* 📌 ADAPTATION POUR LES PETITS ÉCRANS */
        @media (max-width: 920px) {
            .container {
                flex-direction: column;
                text-align: center;
                height: auto;
                padding: 20px;
            }

            .form-container, .image-container {
                width: 100%;
            }

            .image-container img {
                max-width: 80%;
            }

            .btn {
                width: auto;
                padding: 10px 20px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="form-container">
        <h2>Modifier le blog</h2>

        {{ include('blog/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

        <div class="btn-container">
            {{ include('blog/_delete_form.html.twig', { 'button_label': '🗑 Supprimer', 'class': 'btn delete-btn' }) }}
            <a href="{{ path('app_blog_index') }}" class="btn back-btn">⬅ Retour à la liste</a>
        </div>
    </div>

    <div class="image-container">
        <img src="{{ asset('/Dashboard/images/faces/blog.jpg') }}" alt="Blog Image">
    </div>
</div>
{% endblock %}
