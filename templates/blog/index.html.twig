{% extends 'base_back.html.twig' %}

{% block title %}Blog{% endblock %}

{% block stylesheets %}
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f7fa;
            padding: 20px;
        }

        h1 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
            font-size: 22px;
        }

        .content-container {
            max-width: 900px;
            margin: auto;
        }

        .btn-new-container {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .search-box {
            padding: 8px;
            width: 250px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .btn-new {
            background: #4CAF50;
            color: white;
            border: none;
            padding: 10px 15px;
            font-size: 14px;
            border-radius: 5px;
            font-weight: bold;
            text-decoration: none;
            transition: background 0.3s ease;
        }

        .btn-new:hover {
            background: #388E3C;
        }

        .table-container {
            background: white;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            background: white;
        }

        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
            white-space: nowrap;
        }

        th {
            background: #1976D2;
            color: white;
        }

        tr:hover {
            background: #f8f9fa;
        }

        .btn-container {
            display: flex;
            gap: 5px;
        }

        .btn {
            padding: 6px 10px;
            border-radius: 5px;
            text-decoration: none;
            font-size: 12px;
            font-weight: bold;
            transition: all 0.3s ease;
            text-align: center;
            display: inline-block;
        }

        .btn-show { background: #42A5F5; color: white; }
        .btn-show:hover { background: #1E88E5; }

        .btn-edit { background: #FFC107; color: black; }
        .btn-edit:hover { background: #FFA000; }

        .btn-delete { background: #E53935; color: white; border: none; cursor: pointer; }
        .btn-delete:hover { background: #C62828; }
        
        .blog-image {
            width: 60px;
            height: 60px;
            border-radius: 5px;
            object-fit: cover;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="content-container">
        <h1>Gestion des Blogs</h1>
        
        <div class="btn-new-container">
            <input type="text" id="searchInput" class="search-box" placeholder="🔍 Rechercher un blog...">
            <a href="{{ path('app_blog_new') }}" class="btn btn-new">➕ Ajouter un blog</a>
        </div>

        <div class="table-container">
            <table class="table" id="blogTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Titre</th>
                        <th>Contenu</th>
                        <th>Date</th>
                        <th>Auteur</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for blog in blogs %}
                    <tr>
                        <td>{{ blog.id }}</td>
                        <td>
                            {% if blog.image %}
                                <img src="{{ asset('uploads/blog_images/' ~ blog.image) }}" class="blog-image" alt="Image">
                            {% else %}
                                <span style="color: gray;">Aucune image</span>
                            {% endif %}
                        </td>
                        <td>{{ blog.titre }}</td>
                        <td title="{{ blog.contenu }}">{{ blog.contenu|slice(0, 40) ~ '...' }}</td>
                        <td>{{ blog.datePublication ? blog.datePublication|date('Y-m-d') : '' }}</td>
                        <td>{{ blog.auteur }}</td>
                        <td>
                            <div class="btn-container">
                                <a href="{{ path('app_blog_show', {'id': blog.id}) }}" class="btn btn-show">👁 Voir</a>
                                <a href="{{ path('app_blog_edit', {'id': blog.id}) }}" class="btn btn-edit">✏ Modifier</a>
                                <form method="post" action="{{ path('app_blog_delete', {'id': blog.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce blog ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ blog.id) }}">
                                    <button type="submit" class="btn btn-delete">🗑 Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" style="text-align: center; font-weight: bold;">Aucun enregistrement trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.getElementById('searchInput').addEventListener('keyup', function() {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#blogTable tbody tr');
            rows.forEach(row => {
                let title = row.cells[2].textContent.toLowerCase();
                row.style.display = title.includes(filter) ? '' : 'none';
            });
        });
    </script>
{% endblock %}
