{% extends 'base_back.html.twig' %}

{% block title %}Analyse - Détails{% endblock %}

{% block body %}
<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="width: 50rem;">
        <div class="card-body">
            <h1 class="text-center text-primary mb-4">
                <i class="fas fa-flask"></i> Détails de l'Analyse
            </h1>

            <table class="table table-striped">
                <tbody>
                    <tr>
                        <th>Id</th>
                        <td>{{ analyse.id }}</td>
                    </tr>
                    <tr>
                        <th>Nom</th>
                        <td>{{ analyse.nom }}</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ analyse.description }}</td>
                    </tr>
                    <tr>
                        <th>Prix</th>
                        <td>{{ analyse.prix }}</td>
                    </tr>
                    <tr>
                        <th>Type d'Analyse</th>
                        <td>{{ analyse.typeAnalyse }}</td>
                    </tr>
                    <tr>
                        <th>Statut</th>
                        <td>{{ analyse.statut }}</td>
                    </tr>
                    <tr>
                        <th>Date de création</th>
                        <td>{{ analyse.dateCreation ? analyse.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
                    </tr>
                    <tr>
                        <th>Date de mise à jour</th>
                        <td>{{ analyse.dateMiseAJour ? analyse.dateMiseAJour|date('Y-m-d H:i:s') : '' }}</td>
                    </tr>
                </tbody>
            </table>

            <div class="text-center mt-4">
                <a href="{{ path('app_analyse_index') }}" class="btn btn-outline-primary rounded-pill">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>

                <a href="{{ path('app_analyse_edit', {'id': analyse.id}) }}" class="btn btn-outline-warning rounded-pill ml-2">
                    <i class="fas fa-edit"></i> Modifier
                </a>

                <div class="mt-4">
                    {{ include('analyse/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        background: #fff;
        border-radius: 15px;
    }
    .card:hover {
        transform: scale(1.02);
        box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.15);
    }
    .btn-outline-primary {
        border-color: #007bff;
        color: #007bff;
    }
    .btn-outline-primary:hover {
        background-color: #007bff;
        color: white;
    }
    .btn-outline-warning {
        border-color: #e83e8c;
        color: #e83e8c;
    }
    .btn-outline-warning:hover {
        background-color: #e83e8c;
        color: white;
    }
</style>

{% endblock %}
