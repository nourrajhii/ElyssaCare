<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Sélectionner tous les champs de formulaire
        const formFields = document.querySelectorAll('.form-control');

        // Appliquer l'écouteur d'événement 'input' à chaque champ
        formFields.forEach(function(field) {
            field.addEventListener('input', function () {
                // Vérifier la validité du champ
                if (field.validity.valid) {
                    // Si valide, ajouter is-valid et retirer is-invalid
                    field.classList.remove('is-invalid');
                    field.classList.add('is-valid');
                } else {
                    // Si invalide, ajouter is-invalid et retirer is-valid
                    field.classList.remove('is-valid');
                    field.classList.add('is-invalid');
                }
            });
        });
    });
</script>
