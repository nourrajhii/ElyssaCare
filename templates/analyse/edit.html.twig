{% extends 'base_back.html.twig' %}

{% block title %}Modifier une Analyse{% endblock %}

{% block body %}
<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="width: 40rem;">
        <div class="card-body">
            <h1 class="text-center fw-bold mb-4" style="color: #e83e8c;">
                <i class="fas fa-edit"></i> Modifier l'Analyse
            </h1>

            {{ include('analyse/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

            <div class="d-flex justify-content-between mt-4">
                <a href="{{ path('app_analyse_index') }}" class="btn btn-outline-secondary rounded-pill">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>

                {{ include('analyse/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        background: #fff;
        border-radius: 15px;
    }
    .card:hover {
        transform: scale(1.02);
        box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.15);
    }
    .btn-outline-secondary {
        border-color: #e83e8c;
        color: #e83e8c;
    }
    .btn-outline-secondary:hover {
        background-color: #e83e8c;
        color: white;
    }
</style>

{% endblock %}
