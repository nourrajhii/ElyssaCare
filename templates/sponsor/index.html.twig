{% extends 'base_back.html.twig' %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-center text-primary mb-4">Liste des Sponsors</h1>

        <div class="d-flex justify-content-end mb-3">
            <a href="{{ path('app_sponsor_new') }}" class="btn btn-success rounded-pill shadow px-4 py-2 d-flex align-items-center gap-2">
                <i class="fas fa-plus"></i> Ajouter un Sponsor
            </a>
        </div>

        <table class="table table-striped table-bordered text-center">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Prix</th>
                    <th>Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for sponsor in sponsors %}
                <tr>
                    <td>{{ sponsor.id }}</td>
                    <td>{{ sponsor.name }}</td>
                    <td>{{ sponsor.description }}</td>
                    <td>{{ sponsor.prix }}</td>
                    <td>{{ sponsor.type }}</td>
                    <td>
                        <div class="d-flex justify-content-center gap-2">
                            <a href="{{ path('app_sponsor_show', {'id': sponsor.id}) }}" class="btn btn-info text-white btn-sm">
                                <i class="fas fa-eye"></i> Voir
                            </a>
                            <a href="{{ path('app_sponsor_edit', {'id': sponsor.id}) }}" class="btn btn-warning text-white btn-sm">
                                <i class="fas fa-edit"></i> Modifier
                            </a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted">Aucun sponsor trouvé.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}