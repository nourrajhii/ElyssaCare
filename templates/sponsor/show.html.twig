{% extends 'base_back.html.twig' %}

{% block title %}{{ sponsor.name }}{% endblock %}

{% block stylesheets %}
    <style>
        .container {
            width: 50%;
            margin: 50px auto;
            padding: 20px;
            background-color: white;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }

        h1 {
            text-align: center;
            color: #333;
        }

        .sponsor-details p {
            font-size: 1.1rem;
            color: #555;
            margin-bottom: 10px;
        }

        .btn-container {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

        .btn {
            padding: 10px 15px;
            border-radius: 5px;
            text-decoration: none;
            font-size: 1rem;
            color: white;
        }

        .btn-back {
            background-color: #6c757d;
        }

        .btn-edit {
            background-color: #007bff;
        }

        .btn-delete {
            background-color: #dc3545;
            border: none;
            padding: 10px 15px;
            cursor: pointer;
            font-size: 1rem;
            border-radius: 5px;
        }

        .btn-delete:hover {
            background-color: #c82333;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ sponsor.name }}</h1>

        <div class="sponsor-details">
            <p><strong>Description :</strong> {{ sponsor.description }}</p>
            <p><strong>Prix :</strong> {{ sponsor.prix }} </p>
            <p><strong>Type :</strong> {{ sponsor.type }}</p>
        </div>

        <div class="btn-container">
            <a href="{{ path('app_sponsor_index') }}" class="btn btn-back">⬅ Retour à la liste</a>
            <a href="{{ path('app_sponsor_edit', {'id': sponsor.id}) }}" class="btn btn-edit">✏ Modifier</a>
             <form action="{{ path('app_sponsor_delete', {'id': sponsor.id}) }}" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet sponsor ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sponsor.id) }}">
    <button type="submit" class="btn-delete">🗑 Supprimer</button>
</form>
        </div>
    </div>
{% endblock %}