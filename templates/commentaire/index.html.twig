{% extends 'base_back.html.twig' %}

{% block title %}Commentaires{% endblock %}

{% block stylesheets %}
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f7fa;
            padding: 20px;
        }

        h1 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
            font-size: 24px;
            font-weight: bold;
        }

        .content-container {
            max-width: 900px;
            margin: auto;
        }

        .btn-new-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .search-box {
            padding: 10px;
            width: 250px;
            border: 1px solid #ccc;
            border-radius: 8px;
            transition: 0.3s ease;
            font-size: 14px;
        }

        .search-box:focus {
            border-color: #1976D2;
            box-shadow: 0 0 5px rgba(25, 118, 210, 0.5);
            outline: none;
        }

        .btn-new {
            background: #4CAF50;
            color: white;
            border: none;
            padding: 10px 15px;
            font-size: 14px;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
            transition: 0.3s ease;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .btn-new:hover {
            background: #388E3C;
        }

        .table-container {
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            overflow-x: auto;
            overflow-y: auto;
            position: relative;
            max-height: 400px; /* Pour activer le scroll */
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            background: white;
            border-radius: 10px;
            overflow: hidden;
        }

        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
            white-space: nowrap;
        }

        th {
            background: #1976D2;
            color: white;
            position: sticky;
            top: 0;
            z-index: 2;
            text-transform: uppercase;
        }

        tr:hover {
            background: #f8f9fa;
        }

        .btn-container {
            display: flex;
            gap: 5px;
        }

        .btn {
            padding: 6px 12px;
            border-radius: 5px;
            text-decoration: none;
            font-size: 12px;
            font-weight: bold;
            transition: 0.3s ease;
            text-align: center;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .btn-show { background: #42A5F5; color: white; }
        .btn-show:hover { background: #1E88E5; }

        .btn-edit { background: #FFC107; color: black; }
        .btn-edit:hover { background: #FFA000; }

        .btn-delete { background: #E53935; color: white; }
        .btn-delete:hover { background: #C62828; }

        /* Flèche de scroll CENTRÉE DANS LE TABLEAU */
        .scroll-arrow {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            bottom: 10px;
            background: #1976D2;
            color: white;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: none; /* Caché par défaut */
            align-items: center;
            justify-content: center;
            font-size: 20px;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            transition: 0.3s;
        }

        .scroll-arrow:hover {
            background: #1258a8;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="content-container">
        <h1>Gestion des Commentaires</h1>
        
        <div class="btn-new-container">
            <input type="text" id="searchInput" class="search-box" placeholder="🔍 Rechercher un commentaire...">
           
        </div>

        <div class="table-container" id="tableContainer">
            <table class="table" id="commentTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Utilisateur</th>
                        <th>Date</th>
                        <th>Contenu</th>
                        <th>Likes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for commentaire in commentaires %}
                    <tr>
                        <td>{{ commentaire.id }}</td>
                        <td>{{ commentaire.nomUtilisateur }}</td>
                        <td>{{ commentaire.date ? commentaire.date|date('Y-m-d H:i:s') : '' }}</td>
                        <td title="{{ commentaire.contenu }}">{{ commentaire.contenu|slice(0, 40) ~ '...' }}</td>
                        <td>{{ commentaire.nombreLike }}</td>
                        <td>
                            <div class="btn-container">
                                <a href="{{ path('app_commentaire_show', {'id': commentaire.id}) }}" class="btn btn-show">👁 Voir</a>
                                <a href="{{ path('app_commentaire_edit', {'id': commentaire.id}) }}" class="btn btn-edit">✏ Modifier</a>
                                <a href="{{ path('app_commentaire_delete', {'id': commentaire.id}) }}" class="btn btn-delete">🗑 Supprimer</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center; font-weight: bold;">Aucun enregistrement trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <!-- Flèche de défilement -->
            <div id="scrollArrow" class="scroll-arrow" onclick="scrollToTop()">
                ⬆
            </div>
        </div>
    </div>

    <script>
        document.getElementById('searchInput').addEventListener('keyup', function() {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#commentTable tbody tr');
            rows.forEach(row => {
                let content = row.cells[3].textContent.toLowerCase();
                row.style.display = content.includes(filter) ? '' : 'none';
            });
        });

        function confirmDelete(commentId) {
            if (confirm('Voulez-vous vraiment supprimer ce commentaire ?')) {
                window.location.href = `/commentaire/delete/${commentId}`;
            }
        }

        let tableContainer = document.getElementById("tableContainer");
        let scrollArrow = document.getElementById("scrollArrow");

        tableContainer.addEventListener("scroll", function() {
            if (tableContainer.scrollTop > 100) {
                scrollArrow.style.display = "flex";
            } else {
                scrollArrow.style.display = "none";
            }
        });

        function scrollToTop() {
            tableContainer.scrollTo({ top: 0, behavior: "smooth" });
        }
    </script>
{% endblock %}
