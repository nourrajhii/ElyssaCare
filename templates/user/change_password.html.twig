{% extends templateParent %}

{% block title %}Change Password{% endblock %}

{% block body %}
<div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh; background-color: #e0f7fa;">
    <div class="card shadow-sm p-4" style="max-width: 500px; width: 100%; border-radius: 15px; background-color: #ffffff;">
        <h2 class="text-center text-dark mb-4" style="font-family: 'Poppins', sans-serif; font-size: 24px;">Change Password</h2>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        <form method="POST">
            <div class="mb-3">
                <label class="form-label" style="font-weight: bold; font-size: 16px;">Old Password</label>
                <input type="password" name="old_password" class="form-control" style="height: 40px; font-size: 15px;" required>
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-weight: bold; font-size: 16px;">New Password</label>
                <input type="password" name="new_password" class="form-control" style="height: 40px; font-size: 15px;" required>
            </div>
            <div class="mb-3">
    <label class="form-label" style="font-weight: bold; font-size: 16px;">Confirm New Password</label>
    <input type="password" name="confirm_new_password" class="form-control" style="height: 40px; font-size: 15px;" required>
</div>


            <div class="text-center">
                <button type="submit" class="btn btn-primary px-4" style="font-size: 16px;">Update</button>
                <a href="{{ path('app_user_profile', {'id': user.id}) }}" class="btn btn-secondary" style="font-size: 16px;">Cancel</a>
            </div>
        </form>
    </div>
</div>

<style>
    .container {
        padding-top: 30px;
    }

    .card {
        border: none;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }

    .form-label {
        color: #333;
    }

    .form-control {
        border-radius: 8px;
        font-size: 15px;
    }

    .btn {
        border-radius: 20px;
        font-size: 16px;
    }
</style>

{% endblock %}
