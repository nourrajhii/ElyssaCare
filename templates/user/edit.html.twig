{% extends templateParent %}

{% block title %}Edit Profile{% endblock %}

{% block body %}
<div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh; background-color: #e0f7fa;">
    <div class="card shadow-sm p-4" style="max-width: 600px; width: 100%; border-radius: 15px; background-color: #ffffff;">
        <h2 class="text-center text-dark mb-4" style="font-family: 'Poppins', sans-serif; font-size: 26px;">
            Edit Your Profile
        </h2>

        <div class="text-center my-4">
            <img src="{{ asset('front/img/logo.png') }}" alt="Profile Picture" class="rounded-circle border border-light" width="150" height="150">
        </div>

        <form method="POST" action="{{ path('app_user_edit', {'id': user.id}) }}">
            {{ form_start(form) }}

            <!-- Champ Name -->
            <div class="form-group mb-3">
                {{ form_label(form.name, 'Full Name', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <!-- Champ Email -->
            <div class="form-group mb-3">
                {{ form_label(form.email, 'Email Address', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.email) }}
            </div>

                   <div class="text-center mt-3">
                      <a href="{{ path('app_user_change_password', {'id': user.id}) }}" class="btn btn-warning">Change Password</a>
                    </div>
                     <div class="text-center">
                <button type="submit" class="btn btn-primary px-4" style="font-size: 16px;">Update</button>
                <a href="{{ path('app_user_profile', {'id': user.id}) }}" class="btn btn-secondary" style="font-size: 16px;">Cancel</a>
            </div>

            
            {{ form_end(form) }}
        </form>

     
   
    </div>
</div>

<style>
    .container {
        padding-top: 30px;
    }

    .card {
        border: none;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }

    .text-center img {
        border: 4px solid #f0f0f0;
    }

    .form-group label {
        font-weight: bold;
        color: #444;
    }

    .btn {
        margin: 10px;
        font-size: 16px;
        border-radius: 30px;
        font-weight: 500;
    }

    .form-control {
        border-radius: 30px;
        box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.12);
    }
</style>

{% endblock %}
