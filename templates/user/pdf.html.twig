
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile PDF</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            color: #333;
        }
        .profile-table {
            width: 100%;
            border-collapse: collapse;
        }
        .profile-table th, .profile-table td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: left;
        }
        .profile-table th {
            background-color: #f8d7da;
            color: #721c24;
        }
    </style>
</head>
<body>
    <h1>Profile Information</h1>
    <table class="profile-table">
        <tr>
            <th>Name</th>
            <td>{{ user.name }}</td>
        </tr>
        <tr>
            <th>Email</th>
            <td>{{ user.email }}</td>
        </tr>
        <tr>
            <th>Role</th>
            <td>
                {% if 'ROLE_ADMIN' in user.roles %} Admin
                {% elseif 'ROLE_DOCTOR' in user.roles %} Doctor
                {% elseif 'ROLE_PATIENT' in user.roles %} Patient
                {% elseif 'ROLE_PHARMACY' in user.roles %} Pharmacy
                {% else %} User
                {% endif %}
            </td>
        </tr>
    </table>
</body>
</html>
