<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New User</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <style>
        /* Assurez-vous que l'image de fond a un chemin correct */
        body {
            background-image: url('/front/img/frontImg.jpg'); /* Assurez-vous que le chemin est correct */
            background-size: cover; /* Couvre toute la page */
            background-position: center; /* Centré */
            background-repeat: no-repeat; /* Ne pas répéter l'image */
            min-height: 100vh; /* Fond couvrant tout l'écran */
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            background: rgba(255, 255, 255, 0.8); /* Fond semi-transparent pour contraster avec l'image */
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.1);
        }

        .btn-custom {
            background-color: #00aaff;
            color: white;
        }

        .btn-custom:hover {
            background-color: #0088cc;
        }

        .form-group .input-group-text {
            background-color: #00aaff;
            color: white;
        }

        /* Style du lien "Login" */
        .login-link {
            font-size: 1rem;
            text-align: center;
            margin-top: 10px;
            display: block;
            color: #00aaff;
        }

        .login-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="container mt-5">
        <h1 class="text-center"> 𝙎𝙄𝙂𝙉 𝙐𝙋</h1>

        {% block body %}
            <!-- Formulaire -->
            {{ include('user/_form.html.twig') }}
            
            
            <!-- Lien Login avec icône -->
               
                    
            <p class="text-center">Already have an account? <a href="/login" class="login-link"><i class="bi bi-box-arrow-in-right"></i> Login here</a></p>
        {% endblock %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
