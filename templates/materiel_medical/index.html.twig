{% extends 'base_back.html.twig' %}

{% block title %}Gestion des Matériels Médicaux{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap');

        body {
            font-family: 'Poppins', sans-serif;
            color: #566787;
            background: #f5f5f5;
            overflow-y: auto;
        }

        .content-container {
            position: relative;
            top: 80px;
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            animation: fadeIn 1s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #06668C;
            color: white;
            padding: 15px;
            border-radius: 8px;
        }

        .btn-add {
            font-size: 1rem;
            padding: 10px 15px;
            background-color: rgba(245, 242, 242, 0.7);
            color: #06668C;
            border: 2px solid #06668C;
            transition: 0.3s ease-in-out;
            text-decoration: none;
            border-radius: 5px;
        }

        .btn-add:hover {
            background-color: rgb(64, 126, 150);
            color: white;
            transform: scale(1.05);
        }

        .table thead {
            background-color: #06668C;
            color: white;
        }

        .medicament-image {
            max-width: 50px;
            height: auto;
            border-radius: 5px;
        }

        .btn-container {
            display: flex;
            gap: 10px;
        }

        .search-input {
            max-width: 250px;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="content-container w-100">
        <div class="top-bar">
            <h1>Matériels Médicaux</h1>
            <div class="d-flex gap-2">
                <a href="{{ path('app_materiel_medical_new') }}" class="btn btn-add">
                    <i class="bi bi-plus-lg"></i> Ajouter
                </a>
                <input type="text" id="search" class="form-control shadow-sm search-input" placeholder="🔍 Rechercher...">
            </div>
        </div>

        <div class="table-responsive w-100 mt-3">
            <table class="table table-striped table-hover w-100">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Image</th>
                        <th>Description</th>
                        <th>Prix</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="materielTable">
                    {% for materiel_medical in materiel_medicals %}
                        <tr>
                            <td>{{ materiel_medical.id }}</td>
                            <td>{{ materiel_medical.nom }}</td>
                            <td>
                                {% if materiel_medical.image %}
                                    <img src="{{ asset('uploads/materiel_images/' ~ materiel_medical.image) }}" alt="Image de {{ materiel_medical.nom }}">
                                {% else %}
                                    Pas d'image
                                {% endif %}
                            </td>
                            <td>{{ materiel_medical.description }}</td>
                            <td>{{ materiel_medical.prix }} €</td>
                            <td>{{ materiel_medical.statut }}</td>
                            <td>
                                <div class="btn-container">
                                    <a href="{{ path('app_materiel_medical_show', {'id': materiel_medical.id}) }}" class="text-info fs-5">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('app_materiel_medical_edit', {'id': materiel_medical.id}) }}" class="text-warning fs-5">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    {{ include('materiel_medical/_delete_form.html.twig') }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7">Aucun matériel médical trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.getElementById("search").addEventListener("keyup", function() {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll("#materielTable tr");

            rows.forEach(row => {
                let text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? "" : "none";
            });
        });
    </script>
{% endblock %}
