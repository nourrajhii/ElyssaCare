{% extends 'base_front.html.twig' %}

{% block title %}Gestion des Matériels{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css">
    <style>
        body {
            background-color: #1c1c1c;
            font-family: 'Arial', sans-serif;
            color: white;
        }
        .content-container {
            animation: fadeIn 0.8s ease-in-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        .top-bar {
            background-color: #2e2e2e;
            padding: 15px;
            border-radius: 10px;
            text-align: center;
            font-size: 24px;
            font-weight: bold;
        }
        .medicament-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            justify-content: center;
        }
        .medicament-card {
            background: #282828;
            padding: 10px;
            border-radius: 8px;
            transition: transform 0.3s ease-in-out;
            text-align: center;
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 220px;
        }
        .medicament-card:hover {
            transform: scale(1.05);
        }
        .medicament-card h5 {
            color: #ffc107;
            margin-top: 8px;
            font-size: 16px;
        }
        .medicament-card img {
          height: 200px;
            object-fit: cover;
            border-top-left-radius: 15px;
            border-top-right-radius: 15px;
        }
        .medicament-card p {
            font-size: 14px;
        }
        .search-container {
            text-align: center;
            margin: 15px 0;
        }
        .search-container input {
            width: 60%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #ffc107;
            outline: none;
            text-align: center;
            background-color: #333;
            color: white;
        }
        .highlight {
            color: #55acee;
            font-weight: bold;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="content-container w-100">
        <div class="top-bar">
            Most Useful <span class="highlight">Medical Materials</span>
        </div>

        <div class="search-container">
            <input type="text" id="search" class="form-control" placeholder="Rechercher..." aria-label="Rechercher un matériel médical">
        </div>

        <div class="container">
            <div class="medicament-grid" id="medicamentList">
                {% for materiel_medical in materiels %}

                    <a href="{{ path('app_show_front', {'id': materiel_medical.id}) }}" class="text-decoration-none">
                        <div class="medicament-card">
                            <img src="{{ asset(materiel_medical.image ? 'uploads/materiel_images/' ~ materiel_medical.image : 'uploads/default-placeholder.png') }}" 
                                alt="Image de {{ materiel_medical.nom }}" class="img-fluid">
                            <h5>{{ materiel_medical.nom }}</h5>
                            <p class="text-muted">{{ materiel_medical.description }}</p>
                            <p><strong>Classe:</strong> <span class="highlight">{{ materiel_medical.statut }}</span></p>
                            <p><strong>Prix:</strong> {{ materiel_medical.prix|number_format(2, ',', ' ') }} €</p>
                        </div>
                    </a>
                {% else %}
                    <p class="text-center text-muted fw-bold">Aucun matériel médical disponible</p>
                {% endfor %}
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("search");
            const items = document.querySelectorAll(".medicament-card");

            searchInput.addEventListener("input", function() {
                const filter = searchInput.value.toLowerCase();
                items.forEach(item => {
                    const text = item.textContent.toLowerCase();
                    item.style.display = text.includes(filter) ? "block" : "none";
                });
            });
        });
    </script>
{% endblock %}
