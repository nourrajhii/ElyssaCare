{% extends 'base_back.html.twig' %}

{% block title %}Gestion des Médicaments{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap');

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #e3f2fd;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            overflow-y: auto;
        }

        .container {
            display: flex;
            align-items: center;
            justify-content: center;
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            width: 850px;
            max-width: 90%;
            position: relative;
            flex-wrap: wrap;
        }

        .form-container {
            width: 55%;
            padding: 20px;
        }

        .form-container h2 {
            color: #960018;
            text-align: center;
            font-weight: 600;
            font-family: serif;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            font-weight: 500;
            color: #444;
        }

        input, textarea {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            border: 1px solid #ccc;
            border-radius: 8px;
            background: white;
            font-size: 16px;
            transition: border 0.3s ease-in-out;
        }

        input:focus, textarea:focus {
            border: 1px solid #960018;
            outline: none;
        }

        textarea {
            height: 80px;
            resize: none;
        }

        .btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 8px;
            background-color: #960018;
            color: white;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s ease;
        }

        .btn:hover {
            background-color: #b00020;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .image-container {
            width: 45%;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px;
        }

        .image-container img {
            width: 100%;
            max-width: 250px;
            border-radius: 15px;
        }

        @media (max-width: 768px) {
            .container {
                flex-direction: column;
            }
            .form-container, .image-container {
                width: 100%;
            }
            .image-container {
                margin-top: 20px;
            }
        }

        .custom-file-upload {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 2px dashed #960018;
            border-radius: 10px;
            padding: 20px;
            cursor: pointer;
            text-align: center;
            width: 100%;
        }

        .upload-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 16px;
            color: rgb(60, 0, 150);
            font-weight: 500;
            cursor: pointer;
        }

        .upload-label i {
            font-size: 40px;
            margin-bottom: 10px;
        }

        #file-name {
            margin-top: 10px;
            font-size: 14px;
            color: #555;
        }
    </style>
{% endblock %}

{% block body %}
  
<div class="container">

    <div class="container">
        <div class="form-container">
            <h2>Modifier un Materiel</h2>
            <a href="{{ path('app_materiel_medical_index') }}">back to list</a>
        
            {{ include('materiel_medical/_form.html.twig') }}  <!-- Correction ici -->
            {{ include('materiel_medical/_delete_form.html.twig') }}

        </div>
    
        <div class="image-container">
            <img src="{{ asset('/Dashboard/images/faces/medicaments.png') }}" alt="Médicament">
        </div>
    </div>
  
</div>

{% endblock %}
