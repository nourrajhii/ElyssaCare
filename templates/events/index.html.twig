{% extends 'base_back.html.twig' %}

{% block title %}Events{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-center text-primary mb-4">Liste des Événements</h1>

        <div class="d-flex justify-content-end mb-3">
            <a href="{{ path('app_events_new') }}" class="btn btn-success rounded-pill shadow-lg px-4 py-2 d-flex align-items-center gap-2" title="Ajouter un événement">
                <i class="fas fa-plus"></i> Ajouter un autre événement
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered text-center">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Titre</th>
                        <th>Description</th>
                        <th>Lieu</th>
                        <th>Date</th>
                        <th>Image</th>
                        <th>SponsorName</th>

                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for event in events %}
                    <tr>
                        <td>{{ event.id }}</td>
                        <td>{{ event.title }}</td>
                        <td>{{ event.description }}</td>
                        <td>{{ event.lieu }}</td>
                        
                        <td>{{ event.date ? event.date|date('d/m/Y H:i') : 'Non précisé' }}</td>
                        <td>
                            {% if event.image %}
                                <img src="{{ asset('uploads/images/' ~ event.image) }}" alt="Event Image" width="150" class="img-thumbnail">
                            {% else %}
                                <span class="text-muted">Aucune image</span>
                            {% endif %}

                        </td>
                        <td>{{ event.idSponsor}}</td>
                        <td>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <a href="{{ path('app_events_show', {'id': event.id}) }}" class="btn btn-info text-white btn-sm" title="Voir les détails de l'événement">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('app_events_edit', {'id': event.id}) }}" class="btn btn-warning text-white btn-sm" title="Modifier cet événement">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted">Aucun événement trouvé.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}