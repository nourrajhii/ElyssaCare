{% extends 'base_front.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block stylesheets %}
    <style>
        .container {
            width: 50%;
            margin: 50px auto;
            padding: 20px;
            background-color: white;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }

        h1 {
            text-align: center;
            color: #333;
        }

        .event-image {
            width: 100%;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .event-details p {
            font-size: 1.1rem;
            color: #555;
            margin-bottom: 10px;
        }

        .btn-container {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

        .btn {
            padding: 10px 15px;
            border-radius: 5px;
            text-decoration: none;
            font-size: 1rem;
            color: white;
        }

        .btn-back {
            background-color: #6c757d;
        }

        .btn-edit {
            background-color: #007bff;
        }

        .btn-delete {
            background-color: #dc3545;
            border: none;
            padding: 10px 15px;
            cursor: pointer;
            font-size: 1rem;
            border-radius: 5px;
        }

        .btn-delete:hover {
            background-color: #c82333;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">
        {% if event.image %}
            <img src="{{ asset('uploads/images/' ~ event.image) }}" alt="Event Image" class="event-image">
        {% endif %}

        <h1>{{ event.title }}</h1>

        <div class="event-details">
            <p><strong>Description :</strong> {{ event.description }}</p>
            <p><strong>Lieu :</strong> {{ event.lieu }}</p>
            <p><strong>Date :</strong> {{ event.date ? event.date|date('d M Y, H:i') : 'Non définie' }}</p>
            <p><strong>sponsorName :</strong> {{ event.idSponsor}}</p>
        </div>

        <div class="btn-container">
        <a href="{{ path('app_eventes') }}" class="btn btn-back">⬅ Retour à la liste</a>
           
        </div>
    </div>
{% endblock %}